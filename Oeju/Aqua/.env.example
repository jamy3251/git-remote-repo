# 비워두면 데모 모드(가짜 탐지)로 동작합니다.
# Roboflow 대시보드 > Settings > API Keys 의 Private API Key (서버에서만 사용)
ROBOFLOW_API_KEY=
# 동시에 호출할 모델 "project/version" 목록(쉼표 구분). 비워두면 아래 추천 두 개를 사용합니다.
#   aquarium-xj7ov/5        대형 수조·아마존 14종 (mAP50 87.6%)
#   fish-detection-fztlb/3  산호초 관상어 13종 (mAP50 92.1%)
#   aquarium-combined/6     (선택) 무리 단위 보조: shark, jellyfish, stingray 등 (mAP50 77.1%)
ROBOFLOW_MODELS=
# 선택: 기본값 https://serverless.roboflow.com
ROBOFLOW_API_URL=
# 선택: 서버측 최소 신뢰도(0~100), 기본 35
ROBOFLOW_CONFIDENCE=
# 현장 피드백: "아니에요" 사진·현장 촬영을 올릴 내 Roboflow 프로젝트 슬러그 (예: aqua-3kttf)
ROBOFLOW_FEEDBACK_PROJECT=
# 운영자 현장 모드(/field) 암호. 비우면 현장 모드 꺼짐
FIELD_PASSCODE=
# 입구 QR 도착 확인 코드. 비우면 QR 확인 꺼짐 (현장 모드에서 QR 이미지 확인 가능)
CHECKIN_CODE=
