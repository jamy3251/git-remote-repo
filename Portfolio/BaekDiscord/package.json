{
  "name": "devhub",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web",
    "runner"
  ],
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w web",
    "dev:runner": "npm run dev -w runner",
    "build": "npm run build -w runner && npm run build -w web",
    "test": "npm run test -w runner && npm run test -w web",
    "typecheck": "npm run typecheck -w runner && npm run typecheck -w web",
    "lint": "npm run lint -w web",
    "check:protocol": "node scripts/check-protocol.mjs",
    "eval:supervisor": "npm run eval:supervisor -w runner --"
  }
}
