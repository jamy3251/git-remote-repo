# Anthropic API 키 (판정·검색어 확장·군집 이름·코칭)
ANTHROPIC_API_KEY=

# 모델 ID — 이동 별칭(-latest) 금지. 현재 세대는 날짜 접미사 없는 ID가 정식 ID(claude-sonnet-5, claude-haiku-4-5).
# `python -m painpointer models`로 /v1/models 목록을 확인한다. 실제 응답 모델은 llm_calls.response_model에 기록된다.
# 분류·강도·인용(대량, Haiku 계열) / 군집 이름·코칭(2콜, Sonnet 계열)
PP_MODEL_CLASSIFY=claude-haiku-4-5
PP_MODEL_COACH=claude-sonnet-5

# 일일 달러 예산(기본 $3). 오늘 쓴 토큰×가격표 + 이번 작업 최대 견적이 넘으면 시작 전에 거부.
# 리포트 1건 ≈ 평균 $0.4, 최악(800건 전부 긴 글) ≈ $1.3 (Haiku 4.5 판정 기준)
PP_DAILY_BUDGET_USD=3
# 예산 범위: 리포트 $3 중 승격 큐 상한(사용자 몫 $1 보장), 레이더 일 예산·그중 대화 몫·대화 호출 수, 대조 실행 주 예산
PP_BUDGET_PROMOTION=2
PP_RADAR_BUDGET_USD=3
PP_BUDGET_CHAT=1
PP_CHAT_CALL_LIMIT=30
PP_DIAG_BUDGET_USD=3

# 일일 LLM 호출 상한(기본 5000)
PP_DAILY_LLM_LIMIT=5000
PP_LLM_CONCURRENCY=8
# 판정 묶음 크기(한 호출에 글 N건). 시스템 프롬프트를 상각해 입력 토큰 절감. 1 = 글당 1호출
PP_CLASSIFY_BATCH=5

# DB 경로(기본 data/painpointer.db)
# PP_DB=

# 사례 층(v1 기본 OFF) / 유사 시도 층(기본 ON)
PP_SHOW_CASES=0
PP_SHOW_ATTEMPTS=1

# 수집 실패 알림 웹훅(텔레그램/디스코드), 2일 연속 실패 시 전송
PP_WEBHOOK_URL=

# 리포트 하단 피드백·인용 삭제 요청 연락처
PP_FEEDBACK_MAILTO=
PP_FEEDBACK_FORM_URL=
PP_CONTACT_EMAIL=

# 서버 바인딩(로컬 전용)
PP_HOST=127.0.0.1
PP_PORT=8765

# 유사 시도 임계값(설계 0.5\/0.65). 실측 분포 확인 후 조정
# PP_SIM_THRESHOLD=0.5
# PP_SIM_HIGH=0.65

# ---- 기회 레이더 신호 원천(키가 없으면 그 원천만 '키 없음'으로 건너뜀) ----
# OpenAlex: 키 없이도 응답하지만 일일 비용 한도가 작다. 무료 키 발급 권장
PP_OPENALEX_KEY=
# NVD CVE: 키가 있으면 요청 간격 6.5초 → 0.7초
PP_NVD_KEY=
# Semantic Scholar: 선택(없으면 공용 한도)
PP_S2_KEY=
# 네이버 검색·데이터랩(둘 다 있어야 동작)
PP_NAVER_CLIENT_ID=
PP_NAVER_CLIENT_SECRET=
# AI Incident Database 주간 스냅샷 incidents.csv 경로(공개 API는 도메인 제한)
PP_AIID_SNAPSHOT=
# 공적 목록 스냅샷 추가 폴더(painpointer/radar/lists와 같은 JSON 형식)
PP_RADAR_LISTS_DIR=
# 레이더 연결층(T9). 비우면 PP_MODEL_CLASSIFY
PP_MODEL_RADAR=
# 빈자리 고정 검색 규약(D15) 원천 — 둘 중 하나라도 없으면 빈자리·참신성은 '미측정'
PP_KIPRIS_KEY=
PP_NTIS_KEY=
