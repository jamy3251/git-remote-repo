    "lastModified": "2026-09-08T23:17:23.813",
    "vulnStatus": "Awaiting Analysis",
    "cveTags": [],
    "descriptions": [
     {
      "lang": "en",
      "value": "A flaw was found in popt. This vulnerability allows an attacker to provide specially crafted configuration content to a host, which, when loaded, can lead to a small memory corruption issue. This occurs because of an error in how the `poptConfigFileToString` function reallocates memory for buffers. Successful exploitation could result in heap metadata corruption, potentially causing the affected process to become unavailable (denial of service)."
     }
    ],
